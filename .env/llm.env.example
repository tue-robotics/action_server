# Settings of the LLM task planner (action_server.llm).
# Copy this file to llm.env in the same folder and fill it in. llm.env is not committed.
# A variable that is set in the process environment overrules the one in the file.

# Which service to call:
#   openai     api.openai.com, or any server that speaks the OpenAI API (set OPENAI_BASE_URL)
#   azure      Azure OpenAI (GPT models deployed in Azure)
#   foundry    Claude in Microsoft Foundry
#   anthropic  the Claude API, api.anthropic.com
# openai and azure are called with the OpenAI SDK. Claude models have no OpenAI-style endpoint in Foundry,
# so foundry and anthropic use the Messages API.
LLM_PROVIDER=openai

# The model. With openai and anthropic: the model name. With azure and foundry: the name of your deployment.
# It has to support structured output (JSON schema); otherwise set LLM_RESPONSE_FORMAT below.
LLM_MODEL=

# --- LLM_PROVIDER=openai ---
OPENAI_API_KEY=
# Only for another server than api.openai.com, for example a local one: http://localhost:8000/v1
#OPENAI_BASE_URL=

# --- LLM_PROVIDER=azure ---
AZURE_OPENAI_API_KEY=
# https://<your resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Structured output needs 2024-08-01-preview or newer
OPENAI_API_VERSION=2024-10-21

# --- LLM_PROVIDER=foundry ---
# "Key" on the Details tab of the deployment in the Foundry portal
ANTHROPIC_FOUNDRY_API_KEY=
# The "Target URI" on the same tab (https://<resource>.services.ai.azure.com/anthropic/v1/messages),
# or leave it empty and give the resource name below
ANTHROPIC_FOUNDRY_BASE_URL=
#ANTHROPIC_FOUNDRY_RESOURCE=

# --- LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=

# --- Optional ---
# Seconds to wait for an answer
#LLM_TIMEOUT=20
# foundry and anthropic: how much the model reasons before it answers (low, medium, high, ...).
# low is enough for commands and keeps the answer around 2 seconds.
#LLM_EFFORT=low
# openai and azure only. Leave unset for reasoning models, which only accept their default.
#LLM_TEMPERATURE=0
# json_schema (default): the service guarantees the answer follows the schema.
# json_object: for a model or server without structured output; the schema is then only an instruction.
#LLM_RESPONSE_FORMAT=json_schema
# The robot's instructions for the model. Default: $ROBOT_BRINGUP_PATH/parameters/llm/task_planner.md
#LLM_KNOWLEDGE_FILE=
